{
  "name": "push-harder",
  "private": true,
  "type": "module",
  "description": "Herramientas de desarrollo. La app en sí no necesita Node: es HTML/CSS/JS estático.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pushharder \"node --test tests/\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-pushharder",
    "test:engine": "node --test tests/engine.test.js",
    "build:sw": "python3 tools/build-sw.py"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.33.0"
  }
}
