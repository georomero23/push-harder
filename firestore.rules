rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn()     { return request.auth != null; }
    function uid()          { return request.auth.uid; }
    function userData(id)   { return get(/databases/$(database)/documents/users/$(id)).data; }
    function isTrainer()    { return signedIn() && userData(uid()).role == 'trainer'; }
    // Administrador (Geo): se marca a mano en la consola con admin: true. Nadie se lo puede poner solo.
    function isAdmin()      { return signedIn() && userData(uid()).admin == true; }
    function myEmail()      { return request.auth.token.email.lower(); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }

    // Alta con enlace de invitación: la persona crea su propio users/{uid} y, en el mismo lote,
    // suma 1 al contador del enlace. El enlace dice el rol y el entrenador; nadie elige el suyo.
    function inviteOk(userId) {
      let code = incoming().invite;
      let inv = get(invitePath(code)).data;
      let after = getAfter(invitePath(code)).data;
      return isSelf(userId)
        && inv.active == true
        && inv.uses < inv.maxUses
        && request.time.toMillis() < inv.expiresAtMs
        && (inv.email == '' || inv.email == myEmail())
        && incoming().role == inv.role
        && (inv.role == 'trainer'
              ? incoming().trainerId == userId
              : (incoming().trainerId == inv.trainerId && userData(inv.trainerId).role == 'trainer' && userData(inv.trainerId).active == true))
        && incoming().email == myEmail()
        && after.uses == inv.uses + 1
        && after.lastUsedBy == userId;
    }
    function isSelf(id)     { return signedIn() && uid() == id; }
    // trainerId solo lo pone un entrenador al dar de alta y es inmutable.
    function isTrainerOf(id){ return signedIn() && userData(id).trainerId == uid(); }
    function canSee(id)     { return isSelf(id) || isTrainerOf(id); }
    function incoming()     { return request.resource.data; }
    function changed()      { return incoming().diff(resource.data).affectedKeys(); }
    function unchanged(ks)  { return !changed().hasAny(ks); }
    function isStr(v, max)  { return v is string && v.size() <= max; }
    // Banderas de dolor: el alumno puede agregarlas, pero no quitarlas.
    function flagsKept() {
      return !('flags' in resource.data)
        || ('flags' in incoming() && incoming().flags.keys().hasAll(resource.data.flags.keys()));
    }

    // ---------- Usuarios ----------
    match /users/{userId} {
      allow read: if isSelf(userId) || (signedIn() && resource.data.trainerId == uid()) || isAdmin();

      // Altas: (A) un entrenador da de alta a su alumno (el admin, también para otro entrenador),
      // (B) el admin da de alta a un entrenador, (C) la persona se une con un enlace de invitación.
      allow create: if (
          (isTrainer() && incoming().role == 'student'
            && (incoming().trainerId == uid() || (isAdmin() && userData(incoming().trainerId).role == 'trainer')))
          || (isAdmin() && incoming().role == 'trainer' && incoming().trainerId == userId)
          || inviteOk(userId)
        )
        && incoming().active == true
        && incoming().keys().hasOnly(['role','trainerId','name','email','active','prefs','notes','createdAt','updatedAt','invite'])
        && isStr(incoming().name, 80) && isStr(incoming().email, 120);

      // Nadie cambia rol, entrenador ni admin.
      allow update: if
        (isSelf(userId) && changed().hasOnly(['name','prefs','updatedAt']))
        || (isTrainerOf(userId) && changed().hasOnly(['name','active','notes','updatedAt']))
        || (isAdmin() && !isSelf(userId) && changed().hasOnly(['name','active','notes','updatedAt']));
      allow delete: if false;

      // Estructura de la rutina: solo el entrenador.
      match /routines/{routineId} {
        allow read: if canSee(userId);
        allow create: if isTrainerOf(userId)
          && incoming().studentId == userId && incoming().trainerId == uid()
          && incoming().status in ['draft','active','archived'];
        allow update: if isTrainerOf(userId)
          && unchanged(['studentId','trainerId'])
          && incoming().status in ['draft','active','archived'];
        allow delete: if isTrainerOf(userId) && resource.data.status == 'draft';
      }

      // Estado vivo: loads (carga/objetivo por slot), recent (últimas 3), flags (dolor), deload.
      match /progress/{routineId} {
        allow read: if canSee(userId);
        allow create: if isTrainerOf(userId)
          && incoming().studentId == userId && incoming().routineId == routineId;
        allow update: if unchanged(['studentId','routineId']) && (
          isTrainerOf(userId)
          || (isSelf(userId) && changed().hasOnly(['loads','recent','flags','updatedAt']) && flagsKept())
        );
        allow delete: if false;
      }

      // 1 doc por sesión con todas sus series.
      match /sessions/{sessionId} {
        allow read: if canSee(userId);
        allow create: if isSelf(userId)
          && incoming().studentId == userId
          && incoming().trainerId == userData(userId).trainerId
          && incoming().status in ['open','done'];
        allow update: if
          (isSelf(userId) && unchanged(['studentId','trainerId','routineId','dayId']))
          || (isTrainerOf(userId) && changed().hasOnly(['coachNote','updatedAt']));
        allow delete: if isSelf(userId) && resource.data.status == 'open';
      }

      // Propuestas del motor. scope 'load' = carga/reps; 'structure' = variante, sustituto, descarga.
      match /proposals/{proposalId} {
        allow read: if canSee(userId);
        allow create: if canSee(userId)
          && incoming().studentId == userId
          && incoming().trainerId == userData(userId).trainerId
          && incoming().status == 'pending'
          && incoming().scope in ['load','structure'];
        allow update: if resource.data.status == 'pending'
          && incoming().status in ['accepted','rejected','superseded']
          && changed().hasOnly(['status','decidedBy','decidedRole','decidedAt','decisionNote'])
          && incoming().decidedBy == uid()
          && (isTrainerOf(userId) || (isSelf(userId) && resource.data.scope == 'load'));
        allow delete: if false;
      }

      // Historial: solo agregar.
      match /changes/{changeId} {
        allow read: if canSee(userId);
        allow create: if canSee(userId) && incoming().studentId == userId && incoming().by == uid();
        allow update, delete: if false;
      }
    }

    // Vistas del entrenador sobre todos sus alumnos (collection group).
    match /{path=**}/proposals/{proposalId} {
      allow read: if signedIn() && resource.data.trainerId == uid();
    }
    match /{path=**}/sessions/{sessionId} {
      allow read: if signedIn() && resource.data.trainerId == uid();
    }

    // Enlaces de invitación. El código es largo y aleatorio: quien lo tiene ve a quién se une.
    match /invites/{code} {
      allow get: if true;
      allow list: if signedIn() && resource.data.createdBy == uid();
      allow create: if signedIn()
        && code.size() >= 10
        && incoming().keys().hasOnly(['createdBy','trainerId','trainerName','role','name','email','maxUses','uses','active','expiresAtMs','createdAtMs','createdAt'])
        && incoming().createdBy == uid()
        && incoming().uses == 0 && incoming().active == true
        && incoming().maxUses is int && incoming().maxUses >= 1 && incoming().maxUses <= 50
        && incoming().expiresAtMs is int && incoming().expiresAtMs <= request.time.toMillis() + 31 * 86400000
        && isStr(incoming().name, 80) && isStr(incoming().email, 120) && isStr(incoming().trainerName, 80)
        && ((incoming().role == 'student' && isTrainer() && incoming().trainerId == uid())
            || (incoming().role == 'trainer' && isAdmin() && incoming().trainerId == ''));
      allow update: if
        // quien la creó la desactiva
        (signedIn() && resource.data.createdBy == uid() && changed().hasOnly(['active']) && incoming().active == false)
        // quien la usa suma 1, en el mismo lote en que crea su users/{uid} con este código
        || (signedIn() && changed().hasOnly(['uses','lastUsedBy','lastUsedAt'])
            && incoming().uses == resource.data.uses + 1
            && incoming().lastUsedBy == uid()
            && !exists(/databases/$(database)/documents/users/$(uid()))
            && getAfter(/databases/$(database)/documents/users/$(uid())).data.invite == code);
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }

    // Solicitudes de acceso: quien se registra sin enlace pide entrar; solo el admin las ve y decide.
    match /accessRequests/{reqUid} {
      allow read: if isSelf(reqUid) || isAdmin();
      allow create: if isSelf(reqUid)
        && incoming().keys().hasOnly(['email','name','status','createdAtMs','createdAt'])
        && incoming().status == 'pending'
        && incoming().email == myEmail()
        && isStr(incoming().name, 80)
        && !exists(/databases/$(database)/documents/users/$(reqUid));
      allow update: if
        (isSelf(reqUid) && changed().hasOnly(['name','status','createdAtMs','createdAt'])
          && incoming().status == 'pending' && isStr(incoming().name, 80))
        || (isAdmin() && changed().hasOnly(['status','decidedBy','decidedAt'])
          && incoming().status in ['approved','rejected'] && incoming().decidedBy == uid());
      allow delete: if isSelf(reqUid) || isAdmin();
    }

    // Plantillas de rutina del entrenador.
    match /templates/{templateId} {
      allow read, delete: if signedIn() && resource.data.trainerId == uid();
      allow update: if signedIn() && resource.data.trainerId == uid() && unchanged(['trainerId']);
      allow create: if isTrainer() && incoming().trainerId == uid();
    }

    // Ejercicios propios. Lectura pública (son catálogo, como el repo) para que el QR del PDF
    // abra la animación sin iniciar sesión.
    match /exercises/{exerciseId} {
      allow read: if true;
      allow create: if isTrainer() && incoming().ownerId == uid();
      allow update: if signedIn() && resource.data.ownerId == uid() && unchanged(['ownerId']);
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }
  }
}
